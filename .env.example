# Credentials live HERE and nowhere else — never in config.json, never
# in code, never in a log line. This file is gitignored; copy it to
# .env. The UI writes it for you, quoting values so a password with
# spaces or a # survives.
MT5_PASSWORD_LEG_A=""
MT5_PASSWORD_LEG_B=""

# Telegram (optional). Create a bot with @BotFather and paste its token
# here; list the numeric Telegram user ids allowed to use it (ask
# @userinfobot for yours), comma separated. Anyone not listed is
# ignored. Leave the token empty and there is no bot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USERS=""
